package web

import "strconv"
import "github.com/daknoblo/waim/internal/i18n"

templ Settings(d SettingsData) {
	@Page(d.Layout, settingsBody(d.normalized()))
}

templ settingsBody(d SettingsData) {
	<h1 class="mb-4 text-2xl font-semibold">{ d.Layout.T.T("nav.settings") }</h1>
	<nav aria-label={ d.Layout.T.T("settings.tabs.label") } class="mb-5 flex flex-wrap gap-2 rounded-xl border border-slate-800 bg-slate-900/50 p-2">
		for _, tab := range SettingsTabs {
			<a href={ templ.SafeURL(SettingsURL(tab)) } data-settings-tab={ tab } class={ "nav-link text-sm", templ.KV("nav-link-active", d.Tab == tab) }
				if d.Tab == tab {
					aria-current="page"
				}
			>{ d.Layout.T.T("settings.tab." + tab) }</a>
		}
	</nav>
	if d.Message != "" && !d.MetadataOpen {
		<div role="status" class={ "mb-4 rounded-lg px-4 py-3 text-sm", templ.KV("alert-ok", !d.IsError), templ.KV("alert-error", d.IsError) }>{ d.Message }</div>
	}
	if d.Tab == "media" {
		@sourcesBody(d.Sources)
	}
	<noscript>
		<p class="mb-4 rounded-lg bg-amber-500/10 px-4 py-3 text-sm text-amber-200">{ d.Layout.T.T("settings.noScript") }</p>
	</noscript>
	<form
		id="settings-form"
		method="post"
		action={ SettingsURL(d.Tab) }
		class="mt-4 grid gap-4"
		hx-post={ SettingsURL(d.Tab) }
		hx-trigger="change, settings-save"
		hx-swap="none"
		hx-sync="this:queue last"
		hx-indicator="#save-indicator"
		data-saving={ d.Layout.T.T("settings.saving") }
		data-failed={ d.Layout.T.T("settings.saveRetry") }
	>
		@MutationEpoch()
		<input type="hidden" name="tab" value={ d.Tab }/>
		if d.Tab == "metadata" {
		@metadataProviders(d)
		<div class="card grid gap-3">
			<h2 class="text-lg font-semibold">{ d.Layout.T.T("settings.ai") }</h2>
			<p class="text-sm text-slate-400">{ d.Layout.T.T("settings.aiHint") }</p>
			@checkboxField(d.Layout.T.T("settings.aiEnabled"), "ai_enabled", d.Settings.AI.Enabled)
			@textField(d.Layout.T.T("settings.aiEndpoint"), "ai_endpoint", "url", d.Settings.AI.Endpoint, "https://<resource>.services.ai.azure.com/...")
			@secretField(d.Layout.T, "ai_api_key", d.Layout.T.T("settings.aiApiKey"), d.HasAIKey)
			@textField(d.Layout.T.T("settings.aiModel"), "ai_model", "text", d.Settings.AI.Model, "gpt-4o")
			@connStatusBlock("conn-ai", d.Check("ai"))
		</div>
		}
		if d.Tab == "media" {
		<div class="card grid gap-3">
			<h2 class="text-lg font-semibold">{ d.Layout.T.T("settings.scan") }</h2>
			<p class="text-sm text-slate-400">{ d.Layout.T.T("settings.scanHint") }</p>
			@checkboxField(d.Layout.T.T("settings.runOnStart"), "scan_run_on_start", d.Settings.Scan.RunOnStart)
			@checkboxField(d.Layout.T.T("settings.includeSpecials"), "scan_include_specials", d.Settings.Scan.IncludeSpecials)
			<p class="text-xs text-slate-500">{ d.Layout.T.T("settings.includeSpecialsHint") }</p>
		</div>
		}
		if d.Tab == "other" {
		<div class="card grid gap-3">
			<h2 class="text-lg font-semibold">{ d.Layout.T.T("settings.logging") }</h2>
			<label class="grid max-w-xs gap-1 text-sm">
				<span class="text-slate-300">{ d.Layout.T.T("settings.logLevel") }</span>
				<select name="log_level" class="input w-full">
					@logLevelOption(d.Layout.T, "info", d.Settings.LogLevel)
					@logLevelOption(d.Layout.T, "warn", d.Settings.LogLevel)
					@logLevelOption(d.Layout.T, "debug", d.Settings.LogLevel)
				</select>
			</label>
			<p class="text-xs text-slate-500">{ d.Layout.T.T("settings.logLevelHint") }</p>
		</div>
		}
		if d.Tab == "interface" {
		<div class="card grid gap-3">
			<h2 class="text-lg font-semibold">{ d.Layout.T.T("settings.uiLanguage") }</h2>
			<select name="locale" aria-label={ d.Layout.T.T("settings.uiLanguage") } class="input w-full max-w-xs">
				for _, lang := range d.Layout.Languages {
					<option value={ lang.Code } selected?={ lang.Code == d.Settings.Locale }>{ lang.Label }</option>
				}
			</select>
			<div class="grid gap-3 sm:grid-cols-2">
				@choiceSelectField(d.Layout.T.T("settings.language"), "tmdb_language", d.Settings.TMDB.Language, MetadataLanguages(d.Settings.TMDB.Language))
				@choiceSelectField(d.Layout.T.T("settings.region"), "tmdb_region", d.Settings.TMDB.Region, Regions(d.Settings.TMDB.Region))
			</div>
		</div>
		}
		if d.Tab == "other" {
		<div class="card grid gap-3">
			<h2 class="text-lg font-semibold">{ d.Layout.T.T("settings.storage") }</h2>
			<dl class="grid gap-2 text-sm">
				<div><dt class="text-slate-400">{ d.Layout.T.T("settings.dataDir") }</dt><dd class="break-all font-mono">{ d.DataDir }</dd></div>
				<div><dt class="text-slate-400">{ d.Layout.T.T("settings.dbSize") }</dt><dd>{ d.DBSize }</dd></div>
				<div><dt class="text-slate-400">{ d.Layout.T.T("settings.configSize") }</dt><dd>{ d.ConfigSize }</dd></div>
				<div><dt class="text-slate-400">{ d.Layout.T.T("settings.cacheEntries") }</dt><dd>{ strconv.Itoa(d.CacheEntries) }</dd></div>
			</dl>
		</div>
		<div class="card grid gap-3">
			<h2 class="text-lg font-semibold">{ d.Layout.T.T("settings.exports") }</h2>
			<p class="text-sm text-slate-400">{ d.Layout.T.T("settings.exportsHint") }</p>
			<div class="grid gap-2 sm:flex sm:flex-wrap">
				<a class="btn-ghost" href="/export/settings">{ d.Layout.T.T("settings.exportSettings") }</a>
				<a class="btn-ghost" href="/export/sync">{ d.Layout.T.T("settings.exportSync") }</a>
			</div>
		</div>
		}
		<div class="sticky-actions flex flex-wrap items-center justify-end gap-3">
			<div id="save-indicator" role="status" class="text-sm text-slate-400">{ d.Layout.T.T("settings.autoSaveHint") }</div>
			<button id="settings-retry" class="btn-ghost" type="button" hidden>{ d.Layout.T.T("sources.retrySave") }</button>
			<noscript><button class="btn-primary" type="submit">{ d.Layout.T.T("settings.save") }</button></noscript>
		</div>
	</form>
	if d.Tab == "other" {
		@dangerZone(d.Layout.T, d.Demo)
	}
}

// connStatusBlock is the swap target for one section's connection state, so a
// save can update it without re-rendering the form and stealing focus.
templ connStatusBlock(id string, c ConnCheck) {
	<div id={ id }>
		@connStatus(c)
	</div>
}

// SettingsFeedbackFragment answers an auto-save: the touched connection chips
// and the save indicator, each swapped in place.
templ SettingsFeedbackFragment(t *i18n.Translator, fb SettingsFeedback) {
	for _, section := range []string{"tmdb", "ai"} {
		if c, ok := fb.Checks[section]; ok {
			<div id={ "conn-" + section } hx-swap-oob="true">
				@connStatus(c)
			</div>
		}
	}
	<div id="save-indicator" role="status" hx-swap-oob="true" class={ "text-sm", saveStateClass(fb.SaveState) }>
		{ fb.SaveMessage }
	</div>
	if fb.Metadata {
		<div id="metadata-save-indicator" role="status" hx-swap-oob="true" class={ "text-sm", saveStateClass(fb.SaveState) }>{ fb.SaveMessage }</div>
		<div id="metadata-tmdb-status" hx-swap-oob="true">
			@metadataConfigured(t,fb.HasTMDBKey)
		</div>
	}
}

templ textField(label, name, inputType, value, placeholder string) {
	<label class="grid gap-1 text-sm">
		<span class="text-slate-300">{ label }</span>
		<input type={ inputType } name={ name } value={ value } placeholder={ placeholder } class="input" autocomplete="off"/>
	</label>
}

templ numberField(label, name, value, step string) {
	<label class="grid gap-1 text-sm">
		<span class="text-slate-300">{ label }</span>
		<input type="number" name={ name } value={ value } step={ step } min="0" class="input"/>
	</label>
}

templ secretField(t *i18n.Translator, name, label string, hasValue bool) {
	<label class="grid gap-1 text-sm">
		<span class="text-slate-300">{ label }</span>
		if hasValue {
			<input type="password" name={ name } placeholder={ t.T("settings.keyPlaceholderSet") } class="input" autocomplete="new-password"/>
		} else {
			<input type="password" name={ name } class="input" autocomplete="new-password"/>
		}
	</label>
}

templ checkboxField(label, name string, checked bool) {
	<label class="flex items-center gap-2 text-sm">
		<input type="checkbox" name={ name } checked?={ checked } class="checkbox"/>
		<span class="text-slate-300">{ label }</span>
	</label>
}

templ logLevelOption(t *i18n.Translator, value, current string) {
	<option value={ value } selected?={ value == current }>{ t.T("log." + value) }</option>
}

templ choiceSelectField(label, name, current string, options []LangChoice) {
	<label class="grid gap-1 text-sm">
		<span class="text-slate-300">{ label }</span>
		<select name={ name } class="input">
			for _, o := range options {
				<option value={ o.Code } selected?={ o.Code == current }>{ o.Label }</option>
			}
		</select>
	</label>
}

templ connStatus(c ConnCheck) {
	if c.Checked {
		<div class={ "rounded-md px-3 py-2 text-sm", connStateClass(c) }>
			{ c.Message }
		</div>
	}
}
