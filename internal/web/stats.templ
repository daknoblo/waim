package web

import "strconv"
import "github.com/daknoblo/waim/internal/i18n"

templ Stats(d StatsData) {
	@Page(d.Layout, statsBody(d))
}

templ statsBody(d StatsData) {
	<section class="grid gap-4">
		<h1 class="text-lg font-semibold">{ d.Layout.T.T("stats.title") }</h1>
		if !d.HasData {
			<p class="rounded-lg bg-slate-900/60 px-4 py-3 text-sm text-slate-400">{ d.Layout.T.T("stats.noData") }</p>
		} else {
			<div class="grid grid-cols-2 gap-3 text-center sm:grid-cols-3 lg:grid-cols-6">
				@statCardCentered(d.Layout.T.T("stats.itemsScanned"), strconv.Itoa(d.ItemsScanned))
				@statCardCentered(d.Layout.T.T("stats.libraries"), strconv.Itoa(d.LibrariesCount))
				@statCardCentered(d.Layout.T.T("stats.completeness"), strconv.Itoa(d.Completeness)+"%")
				@statCardCentered(d.Layout.T.T("stats.totalGaps"), strconv.Itoa(d.TotalGaps))
				@statCardCentered(d.Layout.T.T("stats.missingUnits"), strconv.Itoa(d.MissingUnits))
				@statCardCentered(d.Layout.T.T("stats.lastScan"), d.LastScan)
			</div>

			<div class="grid gap-4 lg:grid-cols-2">
				<div class="card">
					<h2 class="mb-3 text-lg font-semibold">{ d.Layout.T.T("stats.mediaSplit") }</h2>
					<div class="grid grid-cols-3 gap-3">
						@statCardCentered("\U0001F3AC "+d.Layout.T.T("stats.movies"), strconv.Itoa(d.MoviesScanned))
						@statCardCentered("\U0001F4FA "+d.Layout.T.T("stats.series"), strconv.Itoa(d.SeriesScanned))
						@statCardCentered("\U0001F39E "+d.Layout.T.T("stats.episodes"), strconv.Itoa(d.SeriesEpisodes))
					</div>
				</div>
				<div class="card">
					<h2 class="mb-3 text-lg font-semibold">{ d.Layout.T.T("stats.byKind") }</h2>
					<div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
						@statCardCentered(d.Layout.T.T("finding.kind.missing_season"), strconv.Itoa(d.ByKind.MissingSeasons))
						@statCardCentered(d.Layout.T.T("finding.kind.missing_episodes"), strconv.Itoa(d.ByKind.MissingEpisodes))
						@statCardCentered(d.Layout.T.T("finding.kind.missing_collection"), strconv.Itoa(d.ByKind.MissingCollections))
					</div>
				</div>
			</div>

			<div class="card">
				<h2 class="mb-3 text-lg font-semibold">{ d.Layout.T.T("stats.perLibrary") }</h2>
				<div class="overflow-x-auto">
					<table class="table-cards w-full text-left text-sm">
						<thead class="text-xs uppercase tracking-wide text-slate-500">
							<tr>
								<th class="px-3 py-2">{ d.Layout.T.T("dashboard.library") }</th>
								<th class="px-3 py-2">{ d.Layout.T.T("stats.type") }</th>
								<th class="px-3 py-2">{ d.Layout.T.T("dashboard.scanned") }</th>
								<th class="px-3 py-2">{ d.Layout.T.T("stats.withGaps") }</th>
								<th class="px-3 py-2">{ d.Layout.T.T("dashboard.missing") }</th>
								<th class="px-3 py-2">{ d.Layout.T.T("stats.completeness") }</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-800">
							for _, l := range d.Libraries {
								<tr>
									<td class="px-3 py-2"><span class={ "badge", l.Color }>{ l.Name }</span></td>
									<td class="px-3 py-2 text-slate-400" data-label={ d.Layout.T.T("stats.type") }>{ orDash(l.Type) }</td>
									<td class="px-3 py-2 text-slate-300" data-label={ d.Layout.T.T("dashboard.scanned") }>{ strconv.Itoa(l.Scanned) } / { strconv.Itoa(l.Total) }</td>
									<td class="px-3 py-2 text-slate-300" data-label={ d.Layout.T.T("stats.withGaps") }>{ strconv.Itoa(l.ItemsWithGaps) }</td>
									<td class="px-3 py-2 text-slate-300" data-label={ d.Layout.T.T("dashboard.missing") }>{ strconv.Itoa(l.MissingUnits) }</td>
									<td class="px-3 py-2" data-label={ d.Layout.T.T("stats.completeness") }>
										@completenessBar(l.Completeness)
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>

			<div class="grid gap-4 lg:grid-cols-2">
				@topList(d.Layout.T.T("stats.topSeries"), d.Layout.T.T("stats.missingEpisodes"), d.TopSeries, d.Layout.T.T("stats.noGaps"))
				@topList(d.Layout.T.T("stats.topCollections"), d.Layout.T.T("stats.missingParts"), d.TopCollections, d.Layout.T.T("stats.noGaps"))
			</div>

			@upcomingCard(d.Layout.T, d.Upcoming)

			<h2 class="mt-2 border-b border-slate-800 pb-1 text-base font-semibold text-slate-300">{ d.Layout.T.T("stats.ratingsExisting") }</h2>
			for _, lr := range d.LibraryRatings {
				<div class="grid gap-4 lg:grid-cols-2">
					@ratedListLib(lr.Name, lr.Color, d.Layout.T.T("stats.topRated"), lr.Top, d.Layout.T.T("stats.noMedia"), d.Layout.T.T("stats.showCount"))
					@ratedListLib(lr.Name, lr.Color, d.Layout.T.T("stats.worstRated"), lr.Lowest, d.Layout.T.T("stats.noMedia"), d.Layout.T.T("stats.showCount"))
				</div>
			}

			if len(d.FindingRatings) > 0 || len(d.SeriesFindings) > 0 {
				<h2 class="mt-2 border-b border-slate-800 pb-1 text-base font-semibold text-slate-300">{ d.Layout.T.T("stats.ratingsFindings") }</h2>
				<p class="-mt-2 text-sm text-slate-400">{ d.Layout.T.T("stats.ratingsFindingsHint") }</p>
				for _, lr := range d.FindingRatings {
					<div class="grid gap-4 lg:grid-cols-2">
						@ratedListLib(lr.Name, lr.Color, d.Layout.T.T("stats.topRatedMovies"), lr.Top, d.Layout.T.T("stats.noFindings"), d.Layout.T.T("stats.showCount"))
						@ratedListLib(lr.Name, lr.Color, d.Layout.T.T("stats.worstRatedMovies"), lr.Lowest, d.Layout.T.T("stats.noFindings"), d.Layout.T.T("stats.showCount"))
					</div>
				}
				for _, lr := range d.SeriesFindings {
					<div class="grid gap-4 lg:grid-cols-2">
						@ratedListLib(lr.Name, lr.Color, d.Layout.T.T("stats.topRatedSeries"), lr.Top, d.Layout.T.T("stats.noFindings"), d.Layout.T.T("stats.showCount"))
						@ratedListLib(lr.Name, lr.Color, d.Layout.T.T("stats.worstRatedSeries"), lr.Lowest, d.Layout.T.T("stats.noFindings"), d.Layout.T.T("stats.showCount"))
					</div>
				}
			}

			<h2 class="mt-2 border-b border-slate-800 pb-1 text-base font-semibold text-slate-300">{ d.Layout.T.T("stats.general") }</h2>

			@factsCard(d.Layout.T.T("stats.facts"), d.Facts, d.Layout.T.T("stats.noMedia"))

			<div class="grid gap-4 lg:grid-cols-2">
				@runtimeList(d.Layout.T.T("stats.longest"), d.LongestMovies, d.Layout.T.T("stats.noMedia"))
				@runtimeList(d.Layout.T.T("stats.shortest"), d.ShortestMovies, d.Layout.T.T("stats.noMedia"))
			</div>

			<div class="grid gap-4 lg:grid-cols-2">
				@runtimeList(d.Layout.T.T("stats.longestSeries"), d.LongestSeries, d.Layout.T.T("stats.noSeriesData"))
				@runtimeList(d.Layout.T.T("stats.shortestSeries"), d.ShortestSeries, d.Layout.T.T("stats.noSeriesData"))
			</div>

			@runtimeList(d.Layout.T.T("stats.sagas"), d.Sagas, d.Layout.T.T("stats.noSagas"))

			<div class="grid gap-4 lg:grid-cols-2">
				@pieCard(d.Layout.T.T("stats.byGenre"), d.GenrePie, d.Layout.T.T("stats.noMedia"))
				@barList(d.Layout.T.T("stats.byGenre"), d.Genres, d.Layout.T.T("stats.noMedia"))
			</div>

			<div class="grid gap-4 lg:grid-cols-2">
				@pieCard(d.Layout.T.T("stats.byDecade"), d.YearPie, d.Layout.T.T("stats.noMedia"))
				@barList(d.Layout.T.T("stats.byDecade"), d.Years, d.Layout.T.T("stats.noMedia"))
			</div>

			<div class="grid gap-4 lg:grid-cols-2">
				@pieCard(d.Layout.T.T("stats.byLanguage"), d.LanguagePie, d.Layout.T.T("stats.noOriginData"))
				@barList(d.Layout.T.T("stats.byCountry"), d.Countries, d.Layout.T.T("stats.noOriginData"))
			</div>

			<div class="grid gap-4 lg:grid-cols-2">
				@barList(d.Layout.T.T("stats.ratingSpread"), d.RatingSpread, d.Layout.T.T("stats.noMedia"))
				@genreRatingCard(d.Layout.T.T("stats.genreRatings"), d.Layout.T.T("stats.genreRatingsHint"), d.GenreRatings, d.Layout.T.T("stats.noMedia"))
			</div>

			@growthCard(d.Layout.T.T("stats.growth"), d.Layout.T.T("stats.growthHint"), d.Growth, d.Layout.T.T("stats.noGrowth"))

			@completionCard(d.Layout.T, d.Completion, d.EpisodePct)

			@seasonRatingCard(d.Layout.T, d.SeasonRatings)

			@seriesDetailCard(d.Layout.T, d.SeriesOptions, d.Detail)

			@nicheList(d.Layout.T.T("stats.niches"), d.Layout.T.T("stats.nichesHint"), d.Niches, d.Layout.T.T("stats.noMedia"))
		}
	</section>
}

// titleLink renders a title as a link to Jellyfin or TMDB when one is known.
// min-w-0 lets the truncation kick in inside flex rows on narrow screens.
templ titleLink(title, link string) {
	if link != "" {
		<a
			class="min-w-0 truncate font-medium text-slate-100 transition hover:text-indigo-300 hover:underline"
			href={ templ.SafeURL(link) }
			target="_blank"
			rel="noreferrer noopener"
			title={ title }
		>{ title }</a>
	} else {
		<span class="min-w-0 truncate font-medium text-slate-100">{ title }</span>
	}
}

templ ratedListLib(libName string, color []string, kind string, items []StatsRated, empty, showLabel string) {
	<div class="card">
		<h2 class="mb-3 flex items-center gap-2 text-lg font-semibold">
			<span class={ "badge", color }>{ libName }</span>
			<span>{ kind }</span>
		</h2>
		if len(items) == 0 {
			<p class="text-sm text-slate-500">{ empty }</p>
		} else {
			<ol class="rated-list grid gap-1.5 text-sm">
				for i, it := range items {
					<li class="rated-row flex min-w-0 items-center justify-between gap-2" hidden?={ i >= 10 }>
						<span class="flex min-w-0 items-center gap-2">
							<span class="w-5 shrink-0 text-right text-xs text-slate-600">{ strconv.Itoa(i + 1) }.</span>
							@titleLink(it.Title, it.Link)
							if it.Year > 0 {
								<span class="shrink-0 text-xs text-slate-500">{ strconv.Itoa(it.Year) }</span>
							}
						</span>
						<span class="shrink-0 text-amber-300">{ "\u2605 " + it.Rating }</span>
					</li>
				}
			</ol>
			if len(items) > 10 {
				<div class="mt-3 flex items-center justify-end gap-2 border-t border-slate-800 pt-2">
					<label class="text-xs text-slate-400">{ showLabel }</label>
					<select class="rated-limit lang-select">
						<option value="10" selected>10</option>
						<option value="25">25</option>
						<option value="50">50</option>
					</select>
				</div>
			}
		}
	</div>
}

templ runtimeList(title string, items []StatsRuntime, empty string) {
	<div class="card">
		<h2 class="mb-3 text-lg font-semibold">{ title }</h2>
		if len(items) == 0 {
			<p class="text-sm text-slate-500">{ empty }</p>
		} else {
			<ol class="grid gap-1.5 text-sm">
				for i, it := range items {
					<li class="flex min-w-0 items-center justify-between gap-2">
						<span class="flex min-w-0 items-center gap-2">
							<span class="w-5 shrink-0 text-right text-xs text-slate-600">{ strconv.Itoa(i + 1) }.</span>
							@titleLink(it.Title, it.Link)
							if it.Year > 0 {
								<span class="shrink-0 text-xs text-slate-500">{ strconv.Itoa(it.Year) }</span>
							}
							if it.Detail != "" {
								<span class="badge shrink-0">{ it.Detail }</span>
							}
						</span>
						<span class="shrink-0 text-slate-300">{ it.Runtime }</span>
					</li>
				}
			</ol>
		}
	</div>
}

templ barList(title string, items []StatsBar, empty string) {
	<div class="card">
		<h2 class="mb-3 text-lg font-semibold">{ title }</h2>
		if len(items) == 0 {
			<p class="text-sm text-slate-500">{ empty }</p>
		} else {
			<div class="grid gap-1.5 text-sm">
				for _, b := range items {
					<div class="flex items-center gap-2">
						<span class="w-20 shrink-0 truncate text-slate-300 sm:w-28">{ b.Label }</span>
						@meterBar(b.Pct, "fill-indigo-500", "h-2 flex-1")
						<span class="w-8 shrink-0 text-right text-xs text-slate-400">{ strconv.Itoa(b.Count) }</span>
						<span class="w-10 shrink-0 text-right text-xs text-slate-500">{ strconv.Itoa(b.Share) }%</span>
					</div>
				}
			</div>
		}
	</div>
}

// meterBar draws a proportional bar as SVG: percentage widths live in
// attributes, which the strict CSP allows (inline styles it does not).
// width="100%" keeps the SVG from claiming its intrinsic 300px in flex rows;
// callers that set a width utility class still win over the attribute.
templ meterBar(pct int, fill, class string) {
	<svg class={ "min-w-0", class } width="100%" preserveAspectRatio="none" aria-hidden="true">
		<rect x="0" y="0" width="100%" height="100%" rx="3" class="fill-slate-800"></rect>
		<rect x="0" y="0" width={ strconv.Itoa(pct) + "%" } height="100%" rx="3" class={ fill }></rect>
	</svg>
}

templ pieCard(title string, slices []PieSlice, empty string) {
	<div class="card">
		<h2 class="mb-3 text-lg font-semibold">{ title }</h2>
		if len(slices) == 0 {
			<p class="text-sm text-slate-500">{ empty }</p>
		} else {
			<div class="flex flex-wrap items-center gap-5">
				<svg viewBox="0 0 100 100" class="h-40 w-40 shrink-0" role="img" aria-label={ title }>
					for _, s := range slices {
						<path d={ s.Path } class={ s.Fill }>
							<title>{ s.Label } — { strconv.Itoa(s.Count) } ({ strconv.Itoa(s.Share) }%)</title>
						</path>
					}
				</svg>
				<ul class="grid min-w-[12rem] flex-1 gap-1 text-sm">
					for _, s := range slices {
						<li class="flex items-center gap-2">
							<span class={ "h-2.5 w-2.5 shrink-0 rounded-sm", s.Swatch }></span>
							<span class="min-w-0 flex-1 truncate text-slate-300">{ s.Label }</span>
							<span class="shrink-0 text-xs text-slate-500">{ strconv.Itoa(s.Count) } · { strconv.Itoa(s.Share) }%</span>
						</li>
					}
				</ul>
			</div>
		}
	</div>
}

templ factsCard(title string, facts []StatsFact, empty string) {
	<div class="card">
		<h2 class="mb-3 text-lg font-semibold">{ title }</h2>
		if len(facts) == 0 {
			<p class="text-sm text-slate-500">{ empty }</p>
		} else {
			<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
				for _, f := range facts {
					<div class="rounded-lg bg-slate-900/60 px-3 py-2">
						<div class="text-xs uppercase tracking-wide text-slate-500">
							<span class={ f.IconClass }>{ f.Icon }</span>
							{ f.Label }
						</div>
						<div class="mt-1 truncate text-lg font-semibold text-slate-100" title={ f.Value }>{ f.Value }</div>
						if f.Hint != "" {
							<div class="truncate text-xs text-slate-500">{ f.Hint }</div>
						}
					</div>
				}
			</div>
		}
	</div>
}

templ completionCard(t *i18n.Translator, rows []StatsCompletion, overall int) {
	<div class="card">
		<div class="mb-3 flex flex-wrap items-end justify-between gap-3">
			<div>
				<h2 class="text-lg font-semibold">{ t.T("stats.completion") }</h2>
				<p class="text-sm text-slate-400">{ t.T("stats.completionHint") }</p>
			</div>
			if overall > 0 {
				<span class="text-sm text-slate-300">{ t.T("stats.factEpisodeCompletion") }: { strconv.Itoa(overall) }%</span>
			}
		</div>
		if len(rows) == 0 {
			<p class="text-sm text-slate-500">{ t.T("stats.noSeriesData") }</p>
		} else {
			<div class="rated-list grid gap-1.5 text-sm">
				for i, r := range rows {
					<div
						class="rated-row flex flex-wrap items-center gap-2 sm:flex-nowrap"
						hidden?={ i >= 10 }
						data-title={ r.Title }
						data-pct={ strconv.Itoa(r.Pct) }
						data-missing={ strconv.Itoa(r.Total - r.Owned) }
					>
						<span class="w-full shrink-0 truncate sm:w-44">
							@titleLink(r.Title, r.Link)
						</span>
						<span class="flex flex-1 flex-wrap gap-1">
							for _, c := range r.Cells {
								<span class={ "flex h-5 w-5 items-center justify-center rounded text-[10px] font-medium text-slate-950", c.Fill } title={ c.Hint }>{ c.Label }</span>
							}
						</span>
						<span class="w-20 shrink-0 text-right text-xs text-slate-400 sm:w-24">{ strconv.Itoa(r.Owned) } / { strconv.Itoa(r.Total) }</span>
						<span class="w-10 shrink-0 text-right text-xs text-slate-500">{ strconv.Itoa(r.Pct) }%</span>
					</div>
				}
			</div>
			@listControls(t, completionSortOptions(t), len(rows))
		}
	</div>
}

// listControls adds client-side sorting and an expandable row limit to a list.
templ listControls(t *i18n.Translator, sorts []SortOption, total int) {
	<div class="mt-3 flex flex-wrap items-center gap-2 border-t border-slate-800 pt-2 text-xs text-slate-400 sm:justify-end">
		<span class="w-full sm:w-auto">{ t.T("stats.entries", total) }</span>
		<label class="sm:ml-2">{ t.T("stats.sortBy") }</label>
		<select class="sort-list lang-select" aria-label={ t.T("stats.sortBy") }>
			for _, s := range sorts {
				<option value={ s.Value } selected?={ s.Selected }>{ s.Label }</option>
			}
		</select>
		<label class="ml-2">{ t.T("stats.showCount") }</label>
		<select class="rated-limit lang-select" aria-label={ t.T("stats.showCount") }>
			<option value="10" selected>10</option>
			<option value="25">25</option>
			<option value="50">50</option>
			<option value="100000">{ t.T("stats.showAll") }</option>
		</select>
	</div>
}

templ genreRatingCard(title, hint string, items []StatsRatedGroup, empty string) {
	<div class="card">
		<h2 class="mb-1 text-lg font-semibold">{ title }</h2>
		<p class="mb-3 text-sm text-slate-400">{ hint }</p>
		if len(items) == 0 {
			<p class="text-sm text-slate-500">{ empty }</p>
		} else {
			<div class="grid gap-1.5 text-sm">
				for _, it := range items {
					<div class="flex items-center gap-2">
						<span class="w-20 shrink-0 truncate text-slate-300 sm:w-28">{ it.Label }</span>
						@meterBar(it.Pct, "fill-amber-500", "h-2 flex-1")
						<span class="w-10 shrink-0 text-right text-xs text-amber-300">{ "\u2605 " + it.Rating }</span>
						<span class="w-8 shrink-0 text-right text-xs text-slate-500">{ strconv.Itoa(it.Count) }</span>
					</div>
				}
			</div>
		}
	</div>
}

templ growthCard(title, hint string, items []StatsGrowth, empty string) {
	<div class="card">
		<h2 class="mb-1 text-lg font-semibold">{ title }</h2>
		<p class="mb-3 text-sm text-slate-400">{ hint }</p>
		if len(items) == 0 {
			<p class="text-sm text-slate-500">{ empty }</p>
		} else {
			<div class="grid gap-1.5 text-sm">
				for _, g := range items {
					<div class="flex items-center gap-2">
						<span class="w-24 shrink-0 text-slate-400">{ g.Date }</span>
						@meterBar(g.Pct, "fill-sky-500", "h-2 flex-1")
						<span class="w-12 shrink-0 text-right text-xs text-slate-300">{ strconv.Itoa(g.Titles) }</span>
						<span
							class={ "w-10 shrink-0 text-right text-xs", templ.KV("text-emerald-400", g.Up), templ.KV("text-slate-500", !g.Up) }
						>{ g.Delta }</span>
					</div>
				}
			</div>
		}
	</div>
}

templ seriesDetailCard(t *i18n.Translator, options []SeriesOption, detail SeriesDetail) {
	<div class="card">
		<div class="mb-3 flex flex-wrap items-end justify-between gap-3">
			<div>
				<h2 class="text-lg font-semibold">{ t.T("stats.seriesFlow") }</h2>
				<p class="text-sm text-slate-400">{ t.T("stats.seriesFlowHint") }</p>
			</div>
			if len(options) > 0 {
				<div class="flex w-full flex-wrap items-center gap-2 sm:w-auto">
					<input
						id="series-search"
						type="search"
						autocomplete="off"
						placeholder={ t.T("stats.seriesSearch") }
						aria-label={ t.T("stats.seriesSearch") }
						class="input w-full py-1.5 sm:w-auto sm:text-sm"
					/>
					<select
						id="series-select"
						name="series"
						class="select-filter w-full sm:max-w-xs"
						aria-label={ t.T("stats.seriesFlow") }
						hx-get="/partials/series-flow"
						hx-target="#series-detail"
						hx-swap="innerHTML"
					>
						for _, o := range options {
							<option value={ o.Title } selected?={ o.Selected }>{ o.Label }</option>
						}
					</select>
				</div>
			}
		</div>
		<div id="series-detail">
			@SeriesDetailCharts(t, detail)
		</div>
	</div>
}

templ SeriesDetailCharts(t *i18n.Translator, d SeriesDetail) {
	@seriesFlowChart(t, d.Flow)
	if d.Ratings.Available {
		<div class="mt-5 border-t border-slate-800 pt-4">
			@seriesRatingHeatmap(t, d.Ratings)
		</div>
	} else {
		<p class="mt-4 border-t border-slate-800 pt-4 text-sm text-slate-500">{ t.T("stats.noEpisodeRatings") }</p>
	}
}

templ seriesRatingHeatmap(t *i18n.Translator, r SeriesRatings) {
	<div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
		<span class="font-semibold text-slate-200">{ t.T("stats.episodeRatings") }</span>
		<span class="text-amber-300">{ "\u2605 " + r.Average }</span>
		if r.Trend != "" {
			<span class={ templ.KV("text-emerald-400", r.TrendUp), templ.KV("text-rose-400", !r.TrendUp) }>
				{ t.T("stats.ratingTrend", r.Trend) }
			</span>
		}
	</div>
	<div class="overflow-x-auto">
		<div class="inline-grid gap-1">
			<div class="flex items-center gap-1">
				<span class="w-16 shrink-0"></span>
				for _, c := range r.Columns {
					<span class="w-9 shrink-0 text-center text-[10px] text-slate-600">{ c }</span>
				}
			</div>
			for _, row := range r.Rows {
				<div class="flex items-center gap-1">
					<span class="w-16 shrink-0 truncate text-xs text-slate-400">{ row.Label }</span>
					for _, c := range row.Cells {
						<span
							class={ "flex h-5 w-9 shrink-0 items-center justify-center rounded text-[10px] font-medium text-slate-950", c.Fill, templ.KV("opacity-40", c.Missing) }
							title={ c.Hint }
						>{ c.Label }</span>
					}
					<span class="ml-2 shrink-0 text-xs text-amber-300">{ "\u2605 " + row.Avg }</span>
				</div>
			}
		</div>
	</div>
	<div class="mt-3 flex flex-wrap items-center gap-3 text-xs text-slate-500">
		if r.Best != "" {
			<span>{ t.T("stats.bestEpisode") }: <span class="text-slate-300">{ r.Best }</span></span>
		}
		if r.Worst != "" {
			<span>{ t.T("stats.worstEpisode") }: <span class="text-slate-300">{ r.Worst }</span></span>
		}
		<span>{ t.T("stats.ratingLegend") }</span>
	</div>
}

templ seasonRatingCard(t *i18n.Translator, rows []StatsSeasonRatings) {
	<div class="card">
		<h2 class="mb-1 text-lg font-semibold">{ t.T("stats.seasonRatings") }</h2>
		<p class="mb-3 text-sm text-slate-400">{ t.T("stats.seasonRatingsHint") }</p>
		if len(rows) == 0 {
			<p class="text-sm text-slate-500">{ t.T("stats.noEpisodeRatings") }</p>
		} else {
			<div class="rated-list grid gap-1.5 text-sm">
				for i, r := range rows {
					<div
						class="rated-row flex flex-wrap items-center gap-2 sm:flex-nowrap"
						hidden?={ i >= 10 }
						data-title={ r.Title }
						data-rating={ r.Avg }
						data-seasons={ strconv.Itoa(r.Seasons) }
					>
						<span class="w-full shrink-0 truncate sm:w-44">
							@titleLink(r.Title, r.Link)
						</span>
						<span class="flex flex-1 flex-wrap gap-1">
							for _, c := range r.Cells {
								<span
									class={ "flex h-5 w-9 shrink-0 items-center justify-center rounded text-[10px] font-medium text-slate-950", c.Fill, templ.KV("opacity-40", c.Missing) }
									title={ c.Hint }
								>{ c.Label }</span>
							}
						</span>
						<span class="w-12 shrink-0 text-right text-xs text-amber-300">{ "\u2605 " + r.Avg }</span>
					</div>
				}
			</div>
			@listControls(t, seasonSortOptions(t), len(rows))
		}
	</div>
}

templ seriesFlowChart(t *i18n.Translator, f SeriesFlow) {
	if !f.Available {
		<p class="text-sm text-slate-500">{ t.T("stats.noSeriesData") }</p>
	} else {
		<div class="overflow-x-auto">
			<svg viewBox={ "0 0 720 " + strconv.Itoa(f.Height) } class="w-full min-w-[42rem] sm:min-w-0" role="img" aria-label={ f.Title + " — " + f.Summary }>
				for _, l := range f.Links {
					<path d={ l.Path } class={ l.Fill } fill-opacity="0.3"></path>
				}
				for _, n := range f.Seasons {
					@flowNode(n)
				}
				@flowNode(f.Total)
			</svg>
		</div>
	}
}

templ flowNode(n FlowNode) {
	<rect x={ n.X } y={ n.Y } width={ n.W } height={ n.H } rx="3" class={ n.Fill }></rect>
	<text x={ n.LabelX } y={ n.LabelY } text-anchor={ n.Anchor } dominant-baseline="middle" class="fill-slate-300 text-xs">{ n.Label }</text>
	if n.Sub != "" {
		<text x={ n.LabelX } y={ n.SubY } text-anchor={ n.Anchor } dominant-baseline="middle" class="fill-slate-500 text-xs">{ n.Sub }</text>
	}
}

templ nicheList(title, hint string, items []StatsNiche, empty string) {
	<div class="card">
		<h2 class="mb-1 text-lg font-semibold">{ title }</h2>
		<p class="mb-3 text-sm text-slate-400">{ hint }</p>
		if len(items) == 0 {
			<p class="text-sm text-slate-500">{ empty }</p>
		} else {
			<div class="flex flex-wrap gap-2">
				for _, it := range items {
					<span class="flex items-center gap-2 rounded-lg bg-slate-900/60 px-3 py-1.5 text-sm">
						@titleLink(it.Title, it.Link)
						if it.Year > 0 {
							<span class="text-xs text-slate-500">{ strconv.Itoa(it.Year) }</span>
						}
						<span class="badge">{ it.Reason }</span>
					</span>
				}
			</div>
		}
	</div>
}

templ statCardCentered(label, value string) {
	<div class="rounded-lg bg-slate-900/60 px-3 py-2 text-center">
		<div class="text-xs uppercase tracking-wide text-slate-500">{ label }</div>
		<div class="mt-1 text-lg font-semibold text-slate-100">{ value }</div>
	</div>
}

// upcomingCard lists the releases announced for titles already in the library.
templ upcomingCard(t *i18n.Translator, u StatsUpcoming) {
	<div class="card">
		<div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
			<h2 class="text-lg font-semibold">{ t.T("stats.upcomingTitle") }</h2>
			<p class="text-sm text-slate-400">{ t.T("stats.upcomingHint") }</p>
		</div>
		<div id="upcoming-content">
			@UpcomingContent(t, u)
		</div>
	</div>
}

// UpcomingContent is the swap target of the range and type dropdowns.
templ UpcomingContent(t *i18n.Translator, u StatsUpcoming) {
	if !u.HasAny {
		<p class="text-sm text-slate-500">{ t.T("stats.upcomingEmpty") }</p>
	} else {
		<div class="grid grid-cols-2 gap-3 text-center sm:grid-cols-4">
			@statCardCentered(t.T("stats.upcomingTotal"), strconv.Itoa(u.Total))
			@statCardCentered("\U0001F39E "+t.T("stats.upcomingEpisodes"), strconv.Itoa(u.Episodes))
			@statCardCentered("\U0001F3AC "+t.T("stats.upcomingMovies"), strconv.Itoa(u.Movies))
			@statCardSub(t.T("stats.upcomingNext"), orDash(u.NextLabel), u.NextTitle)
		</div>
		@upcomingTimelineChart(t, u.Timeline)
		<div class="mt-4 flex flex-wrap items-center gap-2 border-t border-slate-800 pt-3 text-xs text-slate-400">
			<label for="upcoming-range">{ t.T("stats.upcomingRange") }</label>
			<select
				id="upcoming-range"
				name="range"
				class="select-filter"
				aria-label={ t.T("stats.upcomingRange") }
				hx-get="/partials/upcoming"
				hx-target="#upcoming-content"
				hx-swap="innerHTML"
				hx-include="#upcoming-type"
			>
				for _, o := range u.Ranges {
					<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
				}
			</select>
			<label for="upcoming-type" class="ml-2">{ t.T("stats.upcomingFilter") }</label>
			<select
				id="upcoming-type"
				name="type"
				class="select-filter"
				aria-label={ t.T("stats.upcomingFilter") }
				hx-get="/partials/upcoming"
				hx-target="#upcoming-content"
				hx-swap="innerHTML"
				hx-include="#upcoming-range"
			>
				for _, o := range u.Types {
					<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
				}
			</select>
			if u.Truncated > 0 {
				<span class="ml-auto">{ t.T("stats.upcomingTruncated", u.Truncated) }</span>
			}
		</div>
		if !u.Available {
			<p class="mt-3 text-sm text-slate-500">{ t.T("stats.upcomingEmptyRange") }</p>
		} else {
			<div class="mt-3 grid gap-3">
				for _, g := range u.Groups {
					@upcomingGroupBlock(g)
				}
			</div>
		}
	}
}

// upcomingTimelineChart plots every dated release on a linear time axis. The
// coordinates are pre-computed server-side, so no inline styles are needed.
templ upcomingTimelineChart(t *i18n.Translator, tl UpcomingTimeline) {
	if tl.Available {
		<div class="mt-4 overflow-x-auto">
			<svg
				id="upcoming-timeline"
				viewBox={ "0 0 1000 " + strconv.Itoa(tl.Height) }
				class="min-w-[36rem] w-full"
				role="img"
				aria-label={ t.T("stats.upcomingTitle") }
			>
				for _, tick := range tl.Ticks {
					<line x1={ tick.X } y1={ tl.AxisY } x2={ tick.X } y2={ tick.Y2 } class="stroke-slate-800" stroke-width="1"></line>
					if tick.Label != "" {
						<text x={ tick.X } y="16" class="fill-slate-500 text-[11px]" text-anchor="middle">{ tick.Label }</text>
					}
				}
				<line x1={ tl.AxisFrom } y1={ tl.AxisY } x2={ tl.AxisTo } y2={ tl.AxisY } class="stroke-slate-700" stroke-width="1"></line>
				for _, m := range tl.Markers {
					<circle cx={ m.CX } cy={ m.CY } r={ m.R } class={ m.Fill } data-type={ m.MediaType }>
						<title>{ m.Title }</title>
					</circle>
				}
			</svg>
		</div>
	}
}

templ upcomingGroupBlock(g UpcomingGroup) {
	<div class="upcoming-group">
		<h3 class="mb-1.5 border-b border-slate-800 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">
			{ g.Label } <span class="font-normal text-slate-600">{ strconv.Itoa(g.Count) }</span>
		</h3>
		<div class="flex gap-2 overflow-x-auto pb-1">
			for _, it := range g.Items {
				@upcomingTile(it)
			}
		</div>
	</div>
}

templ upcomingTile(it UpcomingEntry) {
	<a
		href={ templ.SafeURL(it.Link) }
		target="_blank"
		rel="noreferrer noopener"
		title={ it.Hint }
		class="group w-20 shrink-0"
	>
		if it.PosterURL != "" {
			<img src={ it.PosterURL } alt="" loading="lazy" class="aspect-[2/3] w-full rounded object-cover"/>
		} else {
			<div class="flex aspect-[2/3] w-full items-center justify-center rounded bg-slate-800 text-lg">{ it.Icon }</div>
		}
		<div class="mt-1 truncate text-[11px] font-medium text-slate-200 group-hover:underline">{ it.Title }</div>
		<div class="truncate text-[10px] text-slate-500">{ it.Sub }</div>
		<div class="truncate text-[10px] text-indigo-300">{ it.DateLabel }</div>
	</a>
}

templ statCardSub(label, value, sub string) {
	<div class="rounded-lg bg-slate-900/60 px-3 py-2 text-center">
		<div class="text-xs uppercase tracking-wide text-slate-500">{ label }</div>
		<div class="mt-1 text-lg font-semibold text-slate-100">{ value }</div>
		if sub != "" {
			<div class="text-xs text-slate-400">{ sub }</div>
		}
	</div>
}

templ completenessBar(pct int) {
	<div class="flex items-center gap-2">
		@meterBar(pct, "fill-emerald-500", "h-2 w-24 shrink-0")
		<span class="text-xs text-slate-400">{ strconv.Itoa(pct) }%</span>
	</div>
}

templ topList(title, metric string, items []StatsTop, empty string) {
	<div class="card">
		<h2 class="mb-3 text-lg font-semibold">{ title }</h2>
		if len(items) == 0 {
			<p class="text-sm text-slate-500">{ empty }</p>
		} else {
			<ul class="grid gap-2 text-sm">
				for _, it := range items {
					<li class="flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-0.5">
						<span class="flex min-w-0 items-center gap-2">
							@titleLink(it.Title, it.Link)
							<span class={ "badge shrink-0", it.Color }>{ it.Library }</span>
						</span>
						<span class="text-slate-400 sm:whitespace-nowrap">{ strconv.Itoa(it.Missing) } { metric }</span>
					</li>
				}
			</ul>
		}
	</div>
}
