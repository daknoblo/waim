package web

import (
	"strconv"
	"github.com/daknoblo/waim/internal/i18n"
)

templ ActivityPanel(t *i18n.Translator, activities []ActivityView) {
	<section aria-labelledby="activity-heading" class="min-w-0">
		<div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
			<h2 id="activity-heading" class="text-sm font-semibold text-slate-100">{ t.T("activity.heading") }</h2>
			<p class="text-xs text-slate-400">{ t.T("activity.scope") }</p>
		</div>
		<div class="grid min-w-0 gap-3 xl:grid-cols-3">
			for _, a := range activities {
				@activityCard(t, a)
			}
		</div>
	</section>
}

templ activityCard(t *i18n.Translator, a ActivityView) {
	<article class={ "activity-card", a.Tone() } data-job={ string(a.Job) } data-state={ string(a.Status) }>
		<div class="flex min-w-0 flex-wrap items-center justify-between gap-2">
			<h3 class="min-w-0 text-sm font-semibold text-slate-100">{ t.T(a.JobKey()) }</h3>
			<span class="activity-status">{ t.T(a.StatusKey()) }</span>
		</div>
		if a.Resolved > 0 {
			<p class="mt-2 text-xs text-emerald-300">{ t.T("activity.resolved") }</p>
		}
		if a.IsRunning() {
			<div class="mt-4 flex min-w-0 items-center gap-4">
				<div class="activity-ring" role="progressbar" aria-label={ t.T(a.JobKey()) + " · " + t.T("activity.currentPhase") + " · " + t.T(a.PhaseKey()) }
					if a.HasProgress() {
						aria-valuemin="0"
						aria-valuemax="100"
						aria-valuenow={ strconv.Itoa(a.Percent()) }
					} else {
						aria-valuetext={ t.T(a.ScopeKey()) }
					}
				>
					<svg viewBox="0 0 80 80" class="h-20 w-20" aria-hidden="true">
						<circle cx="40" cy="40" r="34" fill="none" stroke="currentColor" stroke-width="5" class="text-slate-800"></circle>
						if a.HasProgress() {
							<circle cx="40" cy="40" r="34" fill="none" stroke="currentColor" stroke-width="5" pathLength="100" stroke-dasharray={ a.RingValue() } transform="rotate(-90 40 40)" stroke-linecap="round"></circle>
						} else if !a.Known {
							<circle cx="40" cy="40" r="34" fill="none" stroke="currentColor" stroke-width="5" pathLength="100" stroke-dasharray="22 78" stroke-linecap="round" class="activity-indeterminate"></circle>
						}
					</svg>
					<div class="absolute inset-0 flex flex-col items-center justify-center text-center" aria-hidden="true">
						if a.HasProgress() {
							<span class="text-lg font-semibold tabular-nums">{ strconv.Itoa(a.RemainingPercent()) }<span class="text-xs">%</span></span>
							<span class="text-[9px] text-slate-400">{ t.T("activity.remaining") }</span>
						} else if a.Known {
							<span class="text-xl">—</span>
						} else {
							<span class="text-xl">…</span>
						}
					</div>
				</div>
				<div class="min-w-0 flex-1">
					<p class="text-[10px] uppercase tracking-wider text-slate-400">{ t.T("activity.currentPhase") }</p>
					<p class="mt-1 break-words text-sm font-medium text-slate-200">{ t.T(a.PhaseKey()) }</p>
					if a.Current != "" {
						<p class="mt-1 truncate text-sm text-slate-100" title={ a.Current }>{ a.Current }</p>
					}
					if a.Subject != "" {
						<p class="mt-1 truncate text-xs text-slate-400" title={ a.Subject }>{ a.Subject }</p>
					}
					if a.Operation != "" {
						<p class="mt-1 text-xs text-slate-400">{ t.T(a.OperationKey()) }</p>
					}
					if a.Query != "" {
						<p class="mt-1 truncate font-mono text-[10px] text-slate-400">{ a.Query }</p>
					}
					if a.Page > 0 {
						<p class="mt-1 text-xs text-slate-400">{ t.T("activity.page") } { strconv.Itoa(a.Page) }</p>
					}
				</div>
			</div>
			<div class="mt-3 flex flex-wrap justify-between gap-2 border-t border-slate-800 pt-3 text-xs text-slate-400">
				if a.HasProgress() {
					<span class="tabular-nums">{ strconv.Itoa(a.Done) } / { strconv.Itoa(a.Total) } · { strconv.Itoa(a.Remaining()) } { t.T("activity.remaining") }</span>
				} else {
					<span>{ t.T(a.ScopeKey()) }</span>
				}
				<span class="tabular-nums">{ a.Elapsed } { t.T("activity.elapsed") }</span>
			</div>
		} else {
			if !a.IsWaiting() {
				<p class="mt-3 text-xs leading-relaxed text-slate-400">
					{ t.T("activity.detail." + string(a.Status)) }
				</p>
			}
			if a.Phase != "" && !a.IsWaiting() {
				<p class="mt-2 text-xs text-slate-400">{ t.T(a.PhaseKey()) }
					if a.Known {
						<span class="tabular-nums"> · { strconv.Itoa(a.Done) } / { strconv.Itoa(a.Total) }</span>
					}
					if a.Elapsed != "" {
						<span class="tabular-nums"> · { a.Elapsed } { t.T("activity.elapsed") }</span>
					}
				</p>
			}
		}
		if a.Failures > 0 || a.Skipped > 0 || a.Warnings > 0 {
			<p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs">
				if a.Failures > 0 {
					<a href="/logs#diagnostics" data-diagnostics-link="true" class="underline">{ strconv.Itoa(a.Failures) } { t.T("activity.failures") }</a>
				}
				if a.Skipped > 0 {
					<a href="/logs#diagnostics" data-diagnostics-link="true" class="underline">{ strconv.Itoa(a.Skipped) } { t.T("activity.skipped") }</a>
				}
				if a.Warnings > 0 {
					<a href="/logs#diagnostics" data-diagnostics-link="true" class="underline">{ strconv.Itoa(a.Warnings) } { t.T("activity.warnings") }</a>
				}
			</p>
		}
		if len(a.Diagnostics)>0 || a.DiagnosticsTruncated || a.PreviousSeverity!="" {
			<a href="/logs#diagnostics" data-diagnostics-link="true" class="mt-2 inline-block text-xs underline">{ t.T("diagnostics.heading") }</a>
		}
	</article>
}
